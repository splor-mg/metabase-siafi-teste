# Copie para .env.render.local. Use os dados External do Postgres no Render.
# Nunca versione .env.render.local.
PGHOST=preencha-host-externo-do-render
PGPORT=5432
SIAFI_DB=siafi_2026
PGUSER=siafi_admin
PGPASSWORD=preencha-senha-do-postgres-render
SIAFI_OWNER=siafi_owner
SIAFI_OWNER_PASSWORD=gere-uma-senha-exclusiva
METABASE_RO_USER=metabase_leitor
METABASE_RO_PASSWORD=use-a-mesma-senha-definida-no-blueprint
SIAFI_DATA_REPO=../dados-siafi-2026
